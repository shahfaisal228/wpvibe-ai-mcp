# Public WordPress URL, no trailing slash.
WP_SITE_URL=https://homeglo.com.au

# WordPress user that owns the dedicated Application Password.
WP_USERNAME=your-wordpress-username

# Generate a dedicated WordPress Application Password for this MCP server.
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Protect the private MCP endpoint. Use a long random value.
MCP_SHARED_TOKEN=replace-with-at-least-32-random-characters

PORT=3000

# Comma-separated hostnames only (no scheme and no port).
# Add the public MCP hostname after deployment, e.g. mcp.homeglo.com.au.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
