    "content": "<?php\n/**\n * HomeGlo — Interactive Shop the Look.\n *\n * Upgrades the homepage editorial image with accessible hotspots tied to real\n * WooCommerce products. The pins are curated recommendations for the look.\n */\ndefined( 'ABSPATH' ) || exit;\n\nfunction homeglo_shop_look_url( $url ) {\n\tif ( ! empty( $_GET['wpvibe_preview'] ) && is_string( $_GET['wpvibe_preview'] ) ) {\n\t\t$url = add_query_arg(\n\t\t\t'wpvibe_preview',\n\t\t\tsanitize_text_field( wp_unslash( $_GET['wpvibe_preview'] ) ),\n\t\t\t$url\n\t\t);\n\t}\n\treturn $url;\n}\n\nfunction homeglo_shop_look_data() {\n\treturn array(\n\t\tarray(\n\t\t\t'id'    => 140,\n\t\t\t'x'     => 58,\n\t\t\t'y'     => 61,\n\t\t\t'label' => __( 'Pantry edit', 'homeglo-atelier' ),\n\t\t),\n\t\tarray(\n\t\t\t'id'    => 139,\n\t\t\t'x'     => 39,\n\t\t\t'y'     => 55,\n\t\t\t'label' => __( 'Décor accent', 'homeglo-atelier' ),\n\t\t),\n\t\tarray(\n\t\t\t'id'    => 137,\n\t\t\t'x'     => 67,\n\t\t\t'y'     => 27,\n\t\t\t'label' => __( 'Lighting layer', 'homeglo-atelier' ),\n\t\t),\n\t);\n}\n\nfunction homeglo_shop_the_look_homepage() {\n\tif ( ! function_exists( 'wc_get_product' ) ) {\n\t\treturn;\n\t}\n\n\t$items = array();\n\tforeach ( homeglo_shop_look_data() as $item ) {\n\t\t$product = wc_get_product( $item['id'] );\n\t\tif ( ! $product || ! $product->is_visible() ) {\n\t\t\tcontinue;\n\t\t}\n\t\t$item['product'] = $product;\n\t\t$items[] = $item;\n\t}\n\n\tif ( ! $items ) {\n\t\treturn;\n\t}\n\n\t$shop_url = homeglo_shop_look_url( wc_get_page_permalink( 'shop' ) );\n\t?>\n\t<section class=\"hg-hotspot-look\" id=\"shop-the-look\" aria-labelledby=\"hg-hotspot-look-title\" data-hg-hotspot-look>\n\t\t<div class=\"hg-shell\">\n\t\t\t<div class=\"hg-hotspot-look-head\">\n\t\t\t\t<div>\n\t\t\t\t\t<p class=\"hg-hotspot-look-kicker\"><?php esc_html_e( 'Interactive edit', 'homeglo-atelier' ); ?></p>\n\t\t\t\t\t<h2 id=\"hg-hotspot-look-title\"><?php esc_html_e( 'Shop the look.', 'homeglo-atelier' ); ?></h2>\n\t\