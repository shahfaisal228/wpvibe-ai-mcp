l\"><?php echo esc_html( $item['label'] ); ?></span>\n\t\t\t\t\t\t</button>\n\t\t\t\t\t<?php endforeach; ?>\n\n\t\t\t\t\t<div class=\"hg-hotspot-look-card-stack\">\n\t\t\t\t\t\t<?php foreach ( $items as $index => $item ) :\n\t\t\t\t\t\t\t$product   = $item['product'];\n\t\t\t\t\t\t\t$active    = 0 === $index;\n\t\t\t\t\t\t\t$image_id  = $product->get_image_id();\n\t\t\t\t\t\t\t$link      = homeglo_shop_look_url( get_permalink( $product->get_id() ) );\n\t\t\t\t\t\t\t$buyable   = $product->is_type( 'simple' ) && $product->is_purchasable() && $product->is_in_stock();\n\t\t\t\t\t\t\t$category  = wc_get_product_category_list( $product->get_id(), ', ' );\n\t\t\t\t\t\t?>\n\t\t\t\t\t\t\t<article\n\t\t\t\t\t\t\t\tclass=\"hg-hotspot-look-card<?php echo $active ? ' is-active' : ''; ?>\"\n\t\t\t\t\t\t\t\tid=\"hg-look-product-<?php echo esc_attr( $product->get_id() ); ?>\"\n\t\t\t\t\t\t\t\tdata-hg-look-card=\"<?php echo esc_attr( $product->get_id() ); ?>\"\n\t\t\t\t\t\t\t\t<?php echo $active ? '' : 'hidden'; ?>\n\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t<a class=\"hg-hotspot-look-card-media\" href=\"<?php echo esc_url( $link ); ?>\">\n\t\t\t\t\t\t\t\t\t<?php echo wp_get_attachment_image( $image_id, 'woocommerce_thumbnail', false, array( 'loading' => 'lazy' ) ); ?>\n\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t<div class=\"hg-hotspot-look-card-copy\">\n\t\t\t\t\t\t\t\t\t<p><?php esc_html_e( 'Selected for this look', 'homeglo-atelier' ); ?></p>\n\t\t\t\t\t\t\t\t\t<h3><a href=\"<?php echo esc_url( $link ); ?>\"><?php echo esc_html( $product->get_name() ); ?></a></h3>\n\t\t\t\t\t\t\t\t\t<?php if ( $category ) : ?>\n\t\t\t\t\t\t\t\t\t\t<div class=\"hg-hotspot-look-category\"><?php echo wp_kses_post( $category ); ?></div>\n\t\t\t\t\t\t\t\t\t<?php endif; ?>\n\t\t\t\t\t\t\t\t\t<div class=\"hg-hotspot-look-card-bottom\">\n\t\t\t\t\t\t\t\t\t\t<div class=\"hg-hotspot-look-price\"><?php echo wp_kses_post( $product->get_price_html() ); ?></div>\n\t\t\t\t\t\t\t\t\t\t<div class=\"hg-hotspot-look-actions\">\n\t\t\t\t\t\t\t\t\t\t\t<a class=\"hg-hotspot-look-view\" href=\"<?php echo esc_url( $link ); ?>\"><?php esc_html_e( 'View', 'homeglo-atelier' ); ?></a>\n\t\t\t\t\t\t\t\t\t\t\t<?php if ( $buyable ) : ?>\n\t\t\t\t\t\t\t\t\t\t\t\t<a\n\t\t\t\t\t\t\t\t\t\t\t\t\tclass=\"hg-hotspot-look-cart add_to_cart_button ajax_add_to_cart product_type_simple\"\n\t\t\t\t\t\t\t\t\t\t\t\t\thref=\"<?php echo esc_url( $product->add_to_cart_url() ); ?>\"\n\t\t\t\t\t\t\t\t\t\t\t\t\tdata-quantity=\"1\"\n\t\t\t\t\t\t\t\t\t\t\t\t\tdata-product_id=\"<?php echo esc_attr( $product->get_id() ); ?>\"\n\t\t\t\t\t\t\t\t\t\t\t\t\tdata-product_sku=\"<?php echo esc_attr( $product->get_sku() ); ?>\"\n\t\t\t\t\t\t\t\t\t\t\t\t\trel=\"nofollow\"\n\t\t\t\t\t\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<span><?php esc_html_e( 'Add', 'homeglo-atelier' ); ?></span>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg>\n\t\t\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t<?php endif; ?>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</article>\n\t\t\t\t\t\t<?php endforeach; ?>\n\t\t\t\t\t</div>\n\n\t\t\t\t\t<div class=\"hg-hotspot-look-guide\" aria-hidden=\"true\">\n\t\t\t\t\t\t<span></span><?php esc_html_e( 'Tap the markers', 'homeglo-atelier' ); ?>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\n\t\t\t\t<div class=\"hg-hotspot-look-mobile-tabs\" aria-label=\"<?php esc_attr_e( 'Products in this look', 'homeglo-atelier' ); ?>\">\n\t\t\t\t\t<?php foreach ( $items as $index => $item ) :\n\t\t\t\t\t\t$product = $item['product'];\n\t\t\t\t\t?>\n\t\t\t\t\t\t<button\n\t\t\t\t\t\t\ttype=\"button\"\n\t\t\t\t\t\t\tclass=\"<?php echo 0 === $index ? 'is-active' : ''; ?>\"\n\t\t\t\t\t\t\tdata-hg-look-tab=\"<?php echo esc_attr( $product->get_id() ); ?>\"\n\t\t\t\t\t\t\taria-pressed=\"<?php echo 0 === $index ? 'true' : 'false'; ?>\"\n\t\t\t\t\t\t>\n\t\t\t\t\t\t\t<span><?php echo esc_html( sprintf( '%02d', $index + 1 ) ); ?></span>\n\t\t\t\